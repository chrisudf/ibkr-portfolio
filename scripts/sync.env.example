# Copy to sync.env and chmod 600. Never commit this file.
#
# ACCOUNTS: space-separated list of "TOKEN:QUERY_ID" pairs (one per account).
ACCOUNTS="YOUR_FLEX_TOKEN:1111111"

# In-app auto-sync (replaces the retired bash+cron path).
#   AUTO_SYNC:          off | daily | weekly
#   AUTO_SYNC_UTC_HOUR: first attempt at/after this UTC hour (default 9,
#                       ≈ after the previous US close's statement exists)
#   AUTO_SYNC_UTC_DAY:  weekly only, mon..sun (default sat)
# One attempt per due-day, no auto-retry on failure (avoids IBKR 1025
# lockouts) — the dashboard button remains the manual retry.
AUTO_SYNC="daily"
AUTO_SYNC_UTC_HOUR="9"

# Flex poll budget = FLEX_MAX_POLLS * FLEX_POLL_INTERVAL seconds.
# Defaults 120 * 5 = 600s. Raise for a night of diagnosis when IBKR is taking
# longer than the budget to generate (symptom: every attempt ends in 1019
# "Statement generation in progress" after the full budget). Keep the product
# under BUDGET_CEILING_SEC (3600); a wider interval is gentler on IBKR than
# more polls, e.g. 180 * 15 = 2700s with a third of the requests.
#FLEX_MAX_POLLS="180"
#FLEX_POLL_INTERVAL="15"

# Basic auth for the dashboard upload endpoint (matches Caddy basic_auth).
BASIC_AUTH="admin:yourpassword"

# Where to POST the CSV.
UPLOAD_URL="https://your-domain.example/api/upload"
